{\f1
->withSchedule(function (Schedule $schedule): void {\par
    $schedule->command('wa:send-notification')\par
        ->monthlyOn(01, '00:05');\par
    $schedule->command('wa:send-overdue-followup')\par
        ->dailyAt('08:00');\par
})\par
}\f0
