{\f1
public function dispatchMonthlyBatch(?Carbon $referenceDate = null): array\par
{\par
    $referenceDate ??= now();\par
\par
    $preparedNotifications = $this->notificationScheduleService->prepareMonthlyNotifications($referenceDate);\par
    $notifications = $this->notificationScheduleService->firstRemindersReadyForDispatch($referenceDate);\par
\par
    $attemptIds = [];\par
\par
    foreach ($notifications as $notification) {\par
        $attempt = $this->notificationDispatchService->dispatch($notification, 'first_notice_system');\par
        $attemptIds[] = $attempt->id;\par
    }\par
\par
    return [\par
        'prepared_count' => $preparedNotifications->count(),\par
        'processed_count' => count($attemptIds),\par
        'attempt_ids' => $attemptIds,\par
    ];\par
}\par
}\f0
\par
Potongan kode pengingat kedua:\par
{\f1
public function dispatchOverdueFollowUpBatch(?Carbon $referenceDate = null): array\par
{\par
    $referenceDate ??= now();\par
\par
    $notifications = $this->notificationScheduleService->secondRemindersReadyForDispatch($referenceDate);\par
    $attemptIds = [];\par
\par
    foreach ($notifications as $notification) {\par
        $attempt = $this->notificationDispatchService->dispatchSecondReminder($notification, 'second_notice_system');\par
